    {
      "id": 78,
      "clave": "system.heroText",
      "titulo": "LEXDIBRI nace como proyecto de tres estudiantes de 4Geeks que decidimos buscar una solución tecnológica a un problema que encontramos en la sanidad española.",
      "descripcion": "LEXDIBRI nace como proyecto de tres estudiantes de 4Geeks que decidimos buscar una solución tecnológica a un problema que encontramos en la sanidad española."
    },
    {
      "id": 79,
      "clave": "system.historyText",
      "titulo": "Durante el desarrollo del proyecto observamos que la información sanitaria puede encontrarse repartida entre diferentes servicios y comunidades autónomas, haciendo que acceder a determinados recursos o encontrar información relevante no siempre resulte sencillo.",
      "descripcion": "Durante el desarrollo del proyecto observamos que la información sanitaria puede encontrarse repartida entre diferentes servicios y comunidades autónomas, haciendo que acceder a determinados recursos o encontrar información relevante no siempre resulte sencillo."
    },
    {
      "id": 80,
      "clave": "system.techText",
      "titulo": "Para convertir nuestra idea en una plataforma funcional utilizamos diferentes tecnologías y herramientas aprendidas durante nuestra formación.",
      "descripcion": "Para convertir nuestra idea en una plataforma funcional utilizamos diferentes tecnologías y herramientas aprendidas durante nuestra formación."
    },
    {
      "id": 81,
      "clave": "system.goalText",
      "titulo": "LEXDIBRI es nuestro intento de demostrar cómo la tecnología puede ayudar a hacer que la información sanitaria sea más accesible, clara y sencilla para los ciudadanos.",
      "descripcion": "LEXDIBRI es nuestro intento de demostrar cómo la tecnología puede ayudar a hacer que la información sanitaria sea más accesible, clara y sencilla para los ciudadanos."
    },
    {
      "id": 82,
      "clave": "diagnosis.introText",
      "titulo": "Desde sistemas capaces de analizar imágenes médicas mediante inteligencia artificial hasta robots quirúrgicos y tratamientos capaces de dirigir la radiación con una precisión extraordinaria, la tecnología está ampliando las posibilidades de la medicina moderna.",
      "descripcion": "Desde sistemas capaces de analizar imágenes médicas mediante inteligencia artificial hasta robots quirúrgicos y tratamientos capaces de dirigir la radiación con una precisión extraordinaria, la tecnología está ampliando las posibilidades de la medicina moderna."
    },
    {
      "id": 83,
      "clave": "emergency.description",
      "titulo": "Atención sanitaria urgente y acceso rápido a los servicios de emergencia cuando más lo necesitas.",
      "descripcion": "Atención sanitaria urgente y acceso rápido a los servicios de emergencia cuando más lo necesitas."
    },
    {
      "id": 84,
      "clave": "emergency.immediate",
      "titulo": "Ante una emergencia de riesgo vital, actúa rápidamente y contacta con los servicios de emergencia.",
      "descripcion": "Ante una emergencia de riesgo vital, actúa rápidamente y contacta con los servicios de emergencia."
    }
